rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} { allow read: if resource.data.active == true; allow write: if false; }
    match /siteConfig/public { allow read: if true; allow write: if false; }
    match /orders/{id} { allow read: if request.auth != null && resource.data.customerId == request.auth.uid; allow write: if false; }
    match /paymentOrders/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}